{
  "framework": null,
  "buildCommand": "python3 build.py && (npx -y pagefind@1.3.0 --site public || echo Pagefind skipped, quick search still works)",
  "outputDirectory": "public",
  "trailingSlash": true,
  "headers": [
    {"source": "/fonts/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/favicon.svg", "headers": [{"key": "Cache-Control", "value": "public, max-age=604800"}]},
    {"source": "/favicon-48.png", "headers": [{"key": "Cache-Control", "value": "public, max-age=604800"}]},
    {"source": "/apple-touch-icon.png", "headers": [{"key": "Cache-Control", "value": "public, max-age=604800"}]},
    {"source": "/icon-192.png", "headers": [{"key": "Cache-Control", "value": "public, max-age=604800"}]},
    {"source": "/icon-512.png", "headers": [{"key": "Cache-Control", "value": "public, max-age=604800"}]},
    {"source": "/og.png", "headers": [{"key": "Cache-Control", "value": "public, max-age=604800"}]}
  ]
}
